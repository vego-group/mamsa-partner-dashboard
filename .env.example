# Flip to false + set API base to use the real backend with ZERO component changes
NEXT_PUBLIC_USE_MOCK=false
# Dashboard API is ROOT-mounted — NO /api/v1 suffix (that namespace belongs to the
# user-site API; verified: /me -> 401 envelope, /api/v1/me -> 404).
# Production: https://api.mamsaa.com   Staging: https://staging.mamsaa.com
NEXT_PUBLIC_API_BASE_URL=https://api.mamsaa.com

# Shows the bank-account form on /account, and the "add your bank account" CTA on
# the wallet payout strip. Was staging-only while /me/bank-details 404'd; the
# endpoint is live now, and until this is `true` in production a partner has
# nowhere to save an IBAN — which is why the payout run reads empty.
# Compared as an EXACT string: "True" or "1" leave it off.
NEXT_PUBLIC_ENABLE_BANK_DETAILS=true
